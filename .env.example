# Copy to .env (never commit .env). Without a key the app uses the replayed extraction.
LLM_PROVIDER=anthropic          # anthropic | openai | gemini | none
LLM_MODEL=claude-opus-5-5       # optional; provider default if empty
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# SolvaPay sandbox key for Track S (carrier-mcp/); from Console -> Developers -> API Keys
SOLVAPAY_SECRET_KEY=
